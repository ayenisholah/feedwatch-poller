# Copy to .env (gitignored). On AWS these come from SSM Parameter Store (feedwatch-platform docs/DEPLOYMENT.md).
RUST_LOG=info
# Comma-separated JSON-RPC providers per chain; the first is preferred, the rest are failovers.
FEEDWATCH_RPC_ETHEREUM=https://ethereum-rpc.publicnode.com
FEEDWATCH_RPC_ARBITRUM=https://arbitrum-one-rpc.publicnode.com
FEEDWATCH_RPC_BASE=https://base-rpc.publicnode.com
FEEDWATCH_POLL_INTERVAL_SECS=60
INFLUX_URL=http://127.0.0.1:8086
INFLUX_ORG=feedwatch
INFLUX_BUCKET=feedwatch
INFLUX_TOKEN=change-me
